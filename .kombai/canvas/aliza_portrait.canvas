      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap');\n.f-display{font-family:'Cinzel Decorative',serif;}\n.f-serif{font-family:'Cormorant Garamond',serif;}\n.f-body{font-family:'DM Sans',sans-serif;}\n</style>\n<div class=\"f-body\" data-kid=\"1\" data-name=\"page layout container with neon city background\" style=\"background:url('/api/local/images/neoncity.gif') center center / cover no-repeat fixed;\">\n<div class=\"min-h-screen\" data-kid=\"1-1\" data-name=\"main page wrapper with purple gradient overlay\" style=\"background:linear-gradient(160deg, rgba(74,53,102,0.55) 0%, rgba(255,248,240,0.42) 40%, rgba(184,159,200,0.38) 100%);\">\n<nav class=\"sticky top-0 z-30 flex items-center justify-between px-[50px] py-[18px]\" data-kid=\"1-1-1\" data-name=\"sticky top navigation bar\" style=\"background:rgba(74,53,102,0.25);backdrop-filter:blur(20px);border-bottom:1px solid rgba(200,175,215,0.35)\">\n<a class=\"f-display text-[1.1rem] tracking-[0.05em] text-[#e8d8f0] no-underline\" data-kid=\"1-1-1-1\" data-name=\"site logo initials link\" href=\"#\">AF</a>\n<ul class=\"m-0 flex list-none gap-[32px] p-0\" data-kid=\"1-1-1-2\" data-name=\"primary navigation link list\">\n<li data-kid=\"1-1-1-2-1\" data-name=\"nav list item for About link\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"1-1-1-2-1-1\" data-name=\"About navigation link\" href=\"#about\" style=\"color:rgba(232,216,240,0.85)\">About</a></li>\n<li data-kid=\"1-1-1-2-2\" data-name=\"nav list item for Projects link\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"1-1-1-2-2-1\" data-name=\"Projects navigation link\" href=\"#projects\" style=\"color:rgba(232,216,240,0.85)\">Projects</a></li>\n<li data-kid=\"1-1-1-2-3\" data-name=\"nav list item for Skills link\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"1-1-1-2-3-1\" data-name=\"Skills navigation link\" href=\"#skills\" style=\"color:rgba(232,216,240,0.85)\">Skills</a></li>\n<li data-kid=\"1-1-1-2-4\" data-name=\"nav list item for Contact link\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"1-1-1-2-4-1\" data-name=\"Contact mailto navigation link\" href=\"mailto:alizafaraz122@gmail.com\" style=\"color:rgba(232,216,240,0.85)\">Contact</a></li>\n</ul>\n</nav>\n<header class=\"relative flex flex-col items-center justify-center px-[30px] pb-[70px] pt-[60px]\" data-kid=\"1-1-2\" data-name=\"hero header section\" style=\"min-height:660px\">\n<div class=\"pointer-events-none absolute inset-0 z-0\" data-kid=\"1-1-2-1\" data-name=\"radial vignette background layer\" style=\"background:radial-gradient(ellipse 56% 54% at 50% 46%, rgba(30,12,48,0.66) 0%, rgba(30,12,48,0.32) 56%, rgba(30,12,48,0) 80%)\"></div>\n<p class=\"relative z-10 mb-[16px] text-[1.02rem] tracking-[0.18em] uppercase\" data-kid=\"1-1-2-2\" data-name=\"hero welcome eyebrow text\" style=\"font-family:'Cormorant Garamond',serif;font-style:italic;color:#cbb4da;text-shadow:0 2px 14px rgba(20,8,34,0.6)\">Welcome to my corner of the internet</p>\n<h1 class=\"f-display relative z-10 text-center text-white\" data-kid=\"1-1-2-3\" data-name=\"hero headline name\" style=\"font-size:clamp(2.6rem,6vw,4.4rem);line-height:1.08;text-shadow:0 4px 30px rgba(74,53,102,0.7), 0 0 70px rgba(184,159,200,0.28)\">Aliza Faraz</h1>\n<div class=\"relative z-10 mt-[18px] flex flex-col items-center gap-[7px] text-center\" data-kid=\"1-1-2-4\" data-name=\"hero subtitle and status stack\" style=\"text-shadow:0 2px 16px rgba(20,8,34,0.7)\">\n<p class=\"text-[1rem] font-normal\" data-kid=\"1-1-2-4-1\" data-name=\"hero degree/career text\" style=\"color:#fffdfa\">BSc, Systems &amp; Computing Engineering</p>\n<p class=\"text-[0.87rem] font-light\" data-kid=\"1-1-2-4-2\" data-name=\"hero university and location text\" style=\"color:rgba(243,232,250,0.86)\">University of Toronto  ·  Third year  ·  Toronto, Canada</p>\n<p class=\"mt-[5px] flex items-center gap-[8px] text-[0.87rem]\" data-kid=\"1-1-2-4-3\" data-name=\"availability status line\" style=\"color:#fffdfa\">\n<span class=\"block h-[6px] w-[6px] rounded-full\" data-kid=\"1-1-2-4-3-1\" data-name=\"availability status dot indicator\" style=\"background:#a8e6c9\"></span>Open to Summer 2027 internships\n        </p>\n</div>\n<div class=\"relative z-10 mt-[26px] flex items-center gap-[14px]\" data-kid=\"1-1-2-5\" data-name=\"hero social and music controls row\">\n<a aria-label=\"Email\" class=\"grid h-[48px] w-[48px] place-items-center rounded-full no-underline\" data-kid=\"1-1-2-5-1\" data-name=\"email social icon button\" href=\"mailto:alizafaraz122@gmail.com\" style=\"background:rgba(255,255,255,0.12);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(12px)\">\n<img alt=\"Email\" class=\"h-[22px] w-[22px] object-contain\" data-kid=\"1-1-2-5-1-1\" data-name=\"gmail icon image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/gmail.png\"/>\n</a>\n<a aria-label=\"LinkedIn\" class=\"grid h-[48px] w-[48px] place-items-center rounded-full no-underline\" data-kid=\"1-1-2-5-2\" data-name=\"LinkedIn social icon button\" href=\"https://www.linkedin.com/in/aliza-faraz-ba8125249/\" style=\"background:rgba(255,255,255,0.12);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(12px)\">\n<img alt=\"LinkedIn\" class=\"h-[22px] w-[22px] object-contain\" data-kid=\"1-1-2-5-2-1\" data-name=\"LinkedIn icon image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/linkedin.png\"/>\n</a>\n<a aria-label=\"GitHub\" class=\"grid h-[48px] w-[48px] place-items-center rounded-full no-underline\" data-kid=\"1-1-2-5-3\" data-name=\"GitHub social icon button\" href=\"https://github.com/Aliza-F\" style=\"background:rgba(255,255,255,0.12);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(12px)\">\n<img alt=\"GitHub\" class=\"h-[22px] w-[22px] object-contain\" data-kid=\"1-1-2-5-3-1\" data-name=\"GitHub icon image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/git.png\"/>\n</a>\n<span class=\"mx-[4px] block h-[26px] w-px\" data-kid=\"1-1-2-5-4\" data-name=\"vertical divider between socials and player\" style=\"background:rgba(232,216,240,0.25)\"></span>\n<div class=\"inline-flex items-center gap-[12px] rounded-full px-[20px] py-[9px]\" data-kid=\"1-1-2-5-5\" data-name=\"now playing music player widget\" style=\"background:rgba(255,255,255,0.13);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(16px)\">\n<span class=\"text-[0.7rem] uppercase tracking-[0.12em]\" data-kid=\"1-1-2-5-5-1\" data-name=\"now playing label text\" style=\"color:rgba(232,216,240,0.7)\">Now playing</span>\n<button aria-label=\"Play or pause music\" class=\"grid h-[36px] w-[36px] place-items-center rounded-full text-[0.9rem] text-white\" data-dynamic=\"true\" data-kid=\"1-1-2-5-5-2\" data-name=\"play/pause music button\" data-reason=\"button glyph and behavior driven by music player script state\" style=\"background:rgba(184,159,200,0.3);border:1px solid rgba(184,159,200,0.5)\" type=\"button\">▶</button>\n<input aria-label=\"Volume\" class=\"h-[3px] w-[72px] appearance-none rounded-full\" data-kid=\"1-1-2-5-5-3\" data-name=\"audio volume range slider\" max=\"1\" min=\"0\" step=\"0.01\" style=\"background:linear-gradient(90deg,#b89fc8,rgba(184,159,200,0.3))\" type=\"range\" value=\"0.5\"/>\n</div>\n</div>\n<div class=\"absolute bottom-[22px] left-1/2 flex -translate-x-1/2 flex-col items-center gap-[6px]\" data-kid=\"1-1-2-6\" data-name=\"scroll indicator block\">\n<span class=\"text-[0.65rem] uppercase tracking-[0.2em]\" data-kid=\"1-1-2-6-1\" data-name=\"scroll hint text\" style=\"color:rgba(232,216,240,0.5)\">Scroll</span>\n<div class=\"h-[34px] w-px\" data-kid=\"1-1-2-6-2\" data-name=\"scroll indicator line\" style=\"background:linear-gradient(180deg,#b89fc8,transparent)\"></div>\n</div>\n</header>\n<section class=\"relative px-[30px] pb-[100px] pt-[30px]\" data-kid=\"1-1-3\" data-name=\"about section\" id=\"about\">\n<div class=\"mx-auto w-full max-w-[900px]\" data-kid=\"1-1-3-1\" data-name=\"about section outer container\">\n<div class=\"rounded-[24px] px-[52px] py-[48px]\" data-kid=\"1-1-3-1-1\" data-name=\"glassmorphic about card\" style=\"background:rgba(255,252,250,0.58);border:1px solid rgba(199,172,202,0.42);backdrop-filter:blur(18px);box-shadow:0 20px 60px rgba(74,53,102,0.14), inset 0 1px 0 rgba(255,255,255,0.6)\">\n<div class=\"grid grid-cols-1 items-center gap-[36px] lg:grid-cols-[1fr_216px]\" data-kid=\"1-1-3-1-1-1\" data-name=\"about content grid wrapper\">\n<div data-kid=\"1-1-3-1-1-1-1\" data-name=\"about text content column\">\n<span class=\"mb-[10px] block text-[0.7rem] uppercase tracking-[0.25em]\" data-kid=\"1-1-3-1-1-1-1-1\" data-name=\"about greeting eyebrow\" style=\"color:#8f74a8\">Hey there 👋</span>\n<h2 class=\"f-display text-[1.65rem]\" data-kid=\"1-1-3-1-1-1-1-2\" data-name=\"about section heading\" style=\"color:#4a3566\">Welcome</h2>\n<p class=\"f-serif mt-[8px] text-[1.22rem] italic\" data-kid=\"1-1-3-1-1-1-1-3\" data-name=\"about tagline text\" style=\"color:#7b5ea7\">Big ideas start on the trail and come alive in code ✨</p>\n<p class=\"mt-[18px] text-[1rem] font-light\" data-kid=\"1-1-3-1-1-1-1-4\" data-name=\"about biographical paragraph\" style=\"line-height:1.85;color:#3d2d50\">\n                Hi, I'm Aliza! I'm a Systems and Computing Engineering student who loves building cool things — from React apps to Arduino sensors. I genuinely enjoy debugging (yes, really), and I'm currently working on launching my first major game development project. My goal is to use engineering to build a more sustainable and inclusive future.\n              </p>\n</div>\n<div class=\"flex flex-col items-center gap-[10px]\" data-kid=\"1-1-3-1-1-1-2\" data-name=\"about image column wrapper\">\n<div class=\"rounded-[24px] p-[6px]\" data-kid=\"1-1-3-1-1-1-2-1\" data-name=\"profile photo framed card\" style=\"background:rgba(255,255,255,0.6);border:1px solid rgba(199,172,202,0.5);box-shadow:0 16px 40px rgba(74,53,102,0.18)\">\n<img alt=\"Aliza Faraz\" class=\"h-[264px] w-[216px] rounded-[19px] object-cover\" data-kid=\"1-1-3-1-1-1-2-1-1\" data-name=\"profile portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/9026347/pexels-photo-9026347.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=620&amp;q=80\" style=\"object-position:44% 28%\"/>\n</div>\n<button aria-label=\"Toggle greeting animation\" class=\"grid h-[56px] w-[56px] place-items-center overflow-hidden rounded-full\" data-dynamic=\"true\" data-kid=\"1-1-3-1-1-1-2-2\" data-name=\"greeting wave animation button\" data-reason=\"image and animation toggled by greeting script on click\" style=\"background:rgba(255,255,255,0.62);border:1px solid rgba(184,159,200,0.65);box-shadow:0 10px 24px rgba(74,53,102,0.16)\" type=\"button\">\n<img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-1-3-1-1-1-2-2-1\" data-name=\"hello wave gif image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/hello-wave.gif\"/>\n</button>\n</div>\n</div>\n</div>\n</div>\n</section>\n</div>\n</div>",
