      "html": "<link data-kid=\"1\" href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" data-kid=\"2\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link data-kid=\"3\" href=\"https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&amp;family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&amp;family=DM+Sans:wght@300;400;500&amp;display=swap\" rel=\"stylesheet\"/>\n<style>\n.f-display{font-family:'Cinzel Decorative',serif;}\n.f-serif{font-family:'Cormorant Garamond',serif;}\n.f-body{font-family:'DM Sans',sans-serif;}\n</style>\n<div class=\"f-body\" data-kid=\"4\" style=\"background:url('/api/local/images/neoncity.gif') center center / cover no-repeat fixed;\">\n<div class=\"min-h-screen flex flex-col\" data-kid=\"4-1\" style=\"background:linear-gradient(160deg, rgba(74,53,102,0.55) 0%, rgba(255,248,240,0.42) 40%, rgba(184,159,200,0.38) 100%);\">\n<nav class=\"sticky top-0 z-30 flex items-center justify-between px-[50px] py-[18px]\" data-kid=\"4-1-1\" style=\"background:rgba(74,53,102,0.25);backdrop-filter:blur(20px);border-bottom:1px solid rgba(200,175,215,0.35)\">\n<a class=\"f-display text-[1.1rem] tracking-[0.05em] text-[#e8d8f0] no-underline\" data-kid=\"4-1-1-1\" href=\"#\">AF</a>\n<ul class=\"m-0 flex list-none gap-[32px] p-0\" data-kid=\"4-1-1-2\">\n<li data-kid=\"4-1-1-2-1\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"4-1-1-2-1-1\" href=\"#about\" style=\"color:rgba(232,216,240,0.85)\">About</a></li>\n<li data-kid=\"4-1-1-2-2\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"4-1-1-2-2-1\" href=\"#projects\" style=\"color:rgba(232,216,240,0.85)\">Projects</a></li>\n<li data-kid=\"4-1-1-2-3\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"4-1-1-2-3-1\" href=\"#skills\" style=\"color:rgba(232,216,240,0.85)\">Skills</a></li>\n<li data-kid=\"4-1-1-2-4\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"4-1-1-2-4-1\" href=\"mailto:alizafaraz122@gmail.com\" style=\"color:rgba(232,216,240,0.85)\">Contact</a></li>\n</ul>\n</nav>\n<header class=\"relative flex flex-1 items-center px-[30px] pb-[80px] pt-[60px]\" data-kid=\"4-1-2\" style=\"min-height:740px\">\n<div class=\"pointer-events-none absolute inset-0\" data-kid=\"4-1-2-1\" style=\"background:linear-gradient(100deg, rgba(34,16,54,0.72) 0%, rgba(46,24,68,0.42) 44%, rgba(46,24,68,0.02) 78%)\"></div>\n<div class=\"relative mx-auto grid w-full max-w-[1040px] grid-cols-1 items-center gap-[48px] lg:grid-cols-[1fr_316px]\" data-kid=\"4-1-2-2\">\n<div data-kid=\"4-1-2-2-1\">\n<h1 class=\"f-display text-white\" data-kid=\"4-1-2-2-1-1\" style=\"font-size:clamp(2.9rem,5.2vw,4.5rem);line-height:0.99;letter-spacing:-0.005em;text-shadow:0 4px 30px rgba(74,53,102,0.75)\">Aliza<br data-kid=\"4-1-2-2-1-1-1\"/>Faraz</h1>\n<div class=\"mt-[26px] flex flex-col gap-[6px]\" data-kid=\"4-1-2-2-1-2\" style=\"text-shadow:0 2px 16px rgba(20,8,34,0.6)\">\n<p class=\"text-[1.02rem]\" data-kid=\"4-1-2-2-1-2-1\" style=\"color:rgba(255,252,250,0.95)\">BSc, Systems &amp; Computing Engineering</p>\n<p class=\"text-[0.88rem] font-light\" data-kid=\"4-1-2-2-1-2-2\" style=\"color:rgba(232,216,240,0.72)\">University of Toronto  ·  Third year  ·  Toronto, Canada</p>\n<p class=\"mt-[6px] flex items-center gap-[8px] text-[0.88rem]\" data-kid=\"4-1-2-2-1-2-3\" style=\"color:rgba(255,252,250,0.92)\">\n<span class=\"block h-[6px] w-[6px] rounded-full\" data-kid=\"4-1-2-2-1-2-3-1\" style=\"background:#a8e6c9\"></span>Open to Summer 2027 internships\n            </p>\n</div>\n<div class=\"mt-[34px] flex flex-wrap items-center gap-[16px]\" data-kid=\"4-1-2-2-1-3\">\n<div class=\"flex items-center gap-[12px]\" data-kid=\"4-1-2-2-1-3-1\">\n<a aria-label=\"Email\" class=\"grid h-[48px] w-[48px] place-items-center rounded-full no-underline\" data-kid=\"4-1-2-2-1-3-1-1\" href=\"mailto:alizafaraz122@gmail.com\" style=\"background:rgba(255,255,255,0.12);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(12px)\">\n<img alt=\"Email\" class=\"h-[22px] w-[22px] object-contain\" data-kid=\"4-1-2-2-1-3-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/gmail.png\"/>\n</a>\n<a aria-label=\"LinkedIn\" class=\"grid h-[48px] w-[48px] place-items-center rounded-full no-underline\" data-kid=\"4-1-2-2-1-3-1-2\" href=\"https://www.linkedin.com/in/aliza-faraz-ba8125249/\" style=\"background:rgba(255,255,255,0.12);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(12px)\">\n<img alt=\"LinkedIn\" class=\"h-[22px] w-[22px] object-contain\" data-kid=\"4-1-2-2-1-3-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/linkedin.png\"/>\n</a>\n<a aria-label=\"GitHub\" class=\"grid h-[48px] w-[48px] place-items-center rounded-full no-underline\" data-kid=\"4-1-2-2-1-3-1-3\" href=\"https://github.com/Aliza-F\" style=\"background:rgba(255,255,255,0.12);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(12px)\">\n<img alt=\"GitHub\" class=\"h-[22px] w-[22px] object-contain\" data-kid=\"4-1-2-2-1-3-1-3-1\" data-name=\"GitHub icon image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/git.png\"/>\n</a>\n</div>\n<span class=\"block h-[26px] w-px\" data-kid=\"4-1-2-2-1-3-2\" style=\"background:rgba(232,216,240,0.22)\"></span>\n<div class=\"inline-flex items-center gap-[12px] rounded-full px-[20px] py-[9px]\" data-kid=\"4-1-2-2-1-3-3\" style=\"background:rgba(255,255,255,0.13);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(16px)\">\n<span class=\"text-[0.7rem] uppercase tracking-[0.12em]\" data-kid=\"4-1-2-2-1-3-3-1\" style=\"color:rgba(232,216,240,0.7)\">Now playing</span>\n<button aria-label=\"Play or pause music\" class=\"grid h-[36px] w-[36px] place-items-center rounded-full text-[0.9rem] text-white\" data-kid=\"4-1-2-2-1-3-3-2\" style=\"background:rgba(184,159,200,0.3);border:1px solid rgba(184,159,200,0.5)\" type=\"button\">▶</button>\n<span class=\"text-[0.8rem]\" data-kid=\"4-1-2-2-1-3-3-3\">🔊</span>\n<input aria-label=\"Volume\" class=\"h-[3px] w-[72px] appearance-none rounded-full\" data-kid=\"4-1-2-2-1-3-3-4\" max=\"1\" min=\"0\" step=\"0.01\" style=\"background:linear-gradient(90deg,#b89fc8,rgba(184,159,200,0.3))\" type=\"range\" value=\"0.5\"/>\n</div>\n</div>\n</div>\n<div class=\"justify-self-center lg:justify-self-end\" data-kid=\"4-1-2-2-2\">\n<div class=\"rounded-[28px] p-2\" data-kid=\"4-1-2-2-2-1\" style=\"background:rgba(255,255,255,0.13);border:1px solid rgba(232,216,240,0.38);box-shadow:0 26px 60px rgba(24,10,40,0.45)\">\n<img alt=\"Aliza Faraz\" class=\"h-[360px] w-[300px] rounded-[22px] object-cover\" data-kid=\"4-1-2-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/9026347/pexels-photo-9026347.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=760&amp;q=80\" style=\"object-position:42% 22%\"/>\n</div>\n</div>\n</div>\n</header>\n</div>\n</div>",
