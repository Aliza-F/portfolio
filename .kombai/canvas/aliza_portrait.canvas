        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap');\n.f-display{font-family:'Cinzel Decorative',serif;}\n.f-serif{font-family:'Cormorant Garamond',serif;}\n.f-body{font-family:'DM Sans',sans-serif;}\n</style>\n<div class=\"f-body\" data-kid=\"1\" data-name=\"page background container\" style=\"background:url('/api/local/images/neoncity.gif') center center / cover no-repeat fixed;\">\n<div class=\"min-h-screen flex flex-col\" data-kid=\"1-1\" data-name=\"full page layout wrapper with gradient overlay\" style=\"background:linear-gradient(160deg, rgba(74,53,102,0.55) 0%, rgba(255,248,240,0.42) 40%, rgba(184,159,200,0.38) 100%);\">\n<nav class=\"sticky top-0 z-30 flex items-center justify-between px-[50px] py-[18px]\" data-kid=\"1-1-1\" data-name=\"sticky top navigation bar\" style=\"background:rgba(74,53,102,0.25);backdrop-filter:blur(20px);border-bottom:1px solid rgba(200,175,215,0.35)\">\n<a class=\"f-display text-[1.1rem] tracking-[0.05em] text-[#e8d8f0] no-underline\" data-kid=\"1-1-1-1\" data-name=\"site logo text\" href=\"#\">AF</a>\n<ul class=\"m-0 flex list-none gap-[32px] p-0\" data-kid=\"1-1-1-2\" data-name=\"primary navigation links list\">\n<li data-kid=\"1-1-1-2-1\" data-name=\"navigation link item\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"1-1-1-2-1-1\" data-name=\"about navigation link\" href=\"#about\" style=\"color:rgba(232,216,240,0.85)\">About</a></li>\n<li data-kid=\"1-1-1-2-2\" data-name=\"navigation link item\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"1-1-1-2-2-1\" data-name=\"projects navigation link\" href=\"#projects\" style=\"color:rgba(232,216,240,0.85)\">Projects</a></li>\n<li data-kid=\"1-1-1-2-3\" data-name=\"navigation link item\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"1-1-1-2-3-1\" data-name=\"skills navigation link\" href=\"#skills\" style=\"color:rgba(232,216,240,0.85)\">Skills</a></li>\n<li data-kid=\"1-1-1-2-4\" data-name=\"navigation link item\"><a class=\"text-[0.85rem] uppercase tracking-[0.08em] no-underline\" data-kid=\"1-1-1-2-4-1\" data-name=\"contact navigation link\" href=\"mailto:alizafaraz122@gmail.com\" style=\"color:rgba(232,216,240,0.85)\">Contact</a></li>\n</ul>\n</nav>\n<header class=\"relative flex flex-1 flex-col items-center justify-center px-[30px] pb-[120px] pt-[64px]\" data-kid=\"1-1-2\" data-name=\"hero header section\" style=\"min-height:760px\">\n<div class=\"pointer-events-none absolute inset-0 z-0\" data-kid=\"1-1-2-1\" data-name=\"hero radial darkening overlay\" style=\"background:radial-gradient(ellipse 54% 48% at 50% 47%, rgba(30,12,48,0.72) 0%, rgba(30,12,48,0.38) 55%, rgba(30,12,48,0) 80%)\"></div>\n<div class=\"relative z-10 rounded-full p-2\" data-kid=\"1-1-2-2\" data-name=\"profile photo circular frame\" style=\"background:rgba(255,255,255,0.16);border:1px solid rgba(248,240,252,0.68);box-shadow:0 22px 50px rgba(28,12,46,0.45)\">\n<img alt=\"Aliza Faraz\" class=\"h-[184px] w-[184px] rounded-full object-cover\" data-kid=\"1-1-2-2-1\" data-name=\"profile portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/9026347/pexels-photo-9026347.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=520&amp;q=80\" style=\"object-position:44% 26%\"/>\n</div>\n<h1 class=\"f-display relative z-10 mt-[22px] text-center text-white\" data-kid=\"1-1-2-3\" data-name=\"hero name headline\" style=\"font-size:clamp(2.6rem,6vw,4.6rem);line-height:1.08;text-shadow:0 4px 30px rgba(74,53,102,0.7), 0 0 70px rgba(184,159,200,0.28)\">Aliza Faraz</h1>\n<div class=\"relative z-10 mt-4 flex flex-col items-center gap-[7px] text-center\" data-kid=\"1-1-2-4\" data-name=\"hero subtitle info container\" style=\"text-shadow:0 2px 16px rgba(20,8,34,0.7)\">\n<p class=\"text-[1.02rem] font-normal\" data-kid=\"1-1-2-4-1\" data-name=\"degree qualification text\" style=\"color:#fffdfa\">BSc, Systems &amp; Computing Engineering</p>\n<p class=\"text-[0.87rem] font-light tracking-[0.01em]\" data-kid=\"1-1-2-4-2\" data-name=\"university and location text\" style=\"color:rgba(243,232,250,0.86)\">University of Toronto  ·  Third year  ·  Toronto, Canada</p>\n<p class=\"mt-[5px] flex items-center gap-[8px] text-[0.88rem] font-normal\" data-kid=\"1-1-2-4-3\" data-name=\"availability status line\" style=\"color:#fffdfa\">\n<span class=\"block h-[6px] w-[6px] rounded-full\" data-kid=\"1-1-2-4-3-1\" data-name=\"availability status dot indicator\" style=\"background:#a8e6c9\"></span>Open to Summer 2027 internships\n        </p>\n</div>\n<div class=\"relative z-10 mt-[30px] flex items-center gap-[14px]\" data-kid=\"1-1-2-5\" data-name=\"social links container\">\n<a aria-label=\"Email\" class=\"grid h-[48px] w-[48px] place-items-center rounded-full no-underline\" data-kid=\"1-1-2-5-1\" data-name=\"email social link button\" href=\"mailto:alizafaraz122@gmail.com\" style=\"background:rgba(255,255,255,0.12);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(12px)\">\n<img alt=\"Email\" class=\"h-[22px] w-[22px] object-contain\" data-kid=\"1-1-2-5-1-1\" data-name=\"email icon image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/gmail.png\"/>\n</a>\n<a aria-label=\"LinkedIn\" class=\"grid h-[48px] w-[48px] place-items-center rounded-full no-underline\" data-kid=\"1-1-2-5-2\" data-name=\"LinkedIn social link button\" href=\"https://www.linkedin.com/in/aliza-faraz-ba8125249/\" style=\"background:rgba(255,255,255,0.12);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(12px)\">\n<img alt=\"LinkedIn\" class=\"h-[22px] w-[22px] object-contain\" data-kid=\"1-1-2-5-2-1\" data-name=\"LinkedIn icon image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/linkedin.png\"/>\n</a>\n<a aria-label=\"GitHub\" class=\"grid h-[48px] w-[48px] place-items-center rounded-full no-underline\" data-kid=\"1-1-2-5-3\" data-name=\"GitHub social link button\" href=\"https://github.com/Aliza-F\" style=\"background:rgba(255,255,255,0.12);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(12px)\">\n<img alt=\"GitHub\" class=\"h-[22px] w-[22px] object-contain\" data-kid=\"1-1-2-5-3-1\" data-name=\"GitHub icon image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/git.png\"/>\n</a>\n</div>\n<div class=\"mt-[24px] inline-flex items-center gap-[14px] rounded-full px-[22px] py-[10px]\" data-kid=\"1-1-2-6\" data-name=\"music player widget\" style=\"background:rgba(255,255,255,0.13);border:1px solid rgba(200,175,215,0.35);backdrop-filter:blur(16px)\">\n<span class=\"text-[0.72rem] uppercase tracking-[0.12em]\" data-kid=\"1-1-2-6-1\" data-name=\"music label text\" style=\"color:rgba(232,216,240,0.7)\">Now playing</span>\n<button aria-label=\"Play or pause music\" class=\"grid h-[38px] w-[38px] place-items-center rounded-full text-[0.95rem] text-white\" data-dynamic=\"true\" data-kid=\"1-1-2-6-2\" data-name=\"play pause music button\" data-reason=\"play/pause state and icon toggled by script\" style=\"background:rgba(184,159,200,0.3);border:1px solid rgba(184,159,200,0.5)\" type=\"button\">▶</button>\n<span class=\"text-[0.85rem]\" data-dynamic=\"true\" data-kid=\"1-1-2-6-3\" data-name=\"music note status icon\" data-reason=\"icon reflects live playback state set by script\">🔊</span>\n<input aria-label=\"Volume\" class=\"h-[3px] w-[80px] appearance-none rounded-full\" data-dynamic=\"true\" data-kid=\"1-1-2-6-4\" data-name=\"volume slider input\" data-reason=\"fill gradient and value driven by music player state\" max=\"1\" min=\"0\" step=\"0.01\" style=\"background:linear-gradient(90deg,#b89fc8,rgba(184,159,200,0.3))\" type=\"range\" value=\"0.5\"/>\n</div>\n<div class=\"absolute bottom-[26px] left-1/2 flex -translate-x-1/2 flex-col items-center gap-[6px]\" data-kid=\"1-1-2-7\" data-name=\"scroll indicator container\">\n<span class=\"text-[0.65rem] uppercase tracking-[0.2em]\" data-kid=\"1-1-2-7-1\" data-name=\"scroll prompt text\" style=\"color:rgba(232,216,240,0.5)\">Scroll</span>\n<div class=\"h-[40px] w-px\" data-kid=\"1-1-2-7-2\" data-name=\"scroll indicator line\" style=\"background:linear-gradient(180deg,#b89fc8,transparent)\"></div>\n</div>\n</header>\n</div>\n</div>",
